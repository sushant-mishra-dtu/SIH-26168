# --- data: never committed; only the manifest is ---
data/*
!data/README.md
!data/manifest/
!data/manifest/**

# --- build ---
build/
target/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dll
compile_commands.json

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- models / large artefacts ---
*.pt
*.pth
*.onnx
*.tflite
*.pte
runs/
wandb/
lightning_logs/
checkpoints/

# --- maps (regenerate from .pbf; never commit extracts) ---
maps/extracts/
*.pbf
*.osm
*.csr

# --- android ---
# `**/` rather than a top-level match, because build state appears at two depths: `android/` is
# the Gradle root this repo defines, and `android/app/` carries a second wrapper of its own. A
# `a/**/b` pattern matches zero or more directories, so these still cover `android/.gradle/`.
# 49 files of Gradle cache -- lock files and compiled accessor classes -- were tracked before
# this rule existed, which is why every `git status` showed them as modified.
android/**/.gradle/
android/**/local.properties
android/**/build/
*.apk
*.aab
*.keystore

# --- generated figures are reproducible; commit only what the write-up uses ---
eval/figures/_scratch/

# --- local exploration; must not dirty the tree ---
# idr/stamp.py marks an artefact '-dirty' whenever `git status --porcelain` is non-empty,
# and untracked files count. Scratch scripts left lying here would make every generated
# figure unreproducible-by-stamp without changing a single line that produced it.
scratchpad/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
