<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IDR 26168 · replay"
                android:textColor="#E6EDF3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/load_json"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Load JSON..." />
        </LinearLayout>

        <TextView
            android:id="@+id/stamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="no artefact loaded"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="#161B22"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No harness output loaded."
                android:textColor="#E6EDF3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="This screen renders idr-trajectory/1 records written by eval/run.py. It contains no physics and no simulation — select a trajectory JSON file using the button above to render it."
                android:textColor="#8B949E"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Main Replay Content -->
        <LinearLayout
            android:id="@+id/replay_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Trajectory Map Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trajectory · local NED, metres"
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <org.idr26168.logger.replay.TrajectoryMapView
                    android:id="@+id/map_view"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="8dp" />

                <!-- Legend -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="— Truth (white)   — Filter InEKF (blue)\n— Strapdown (red)   — GNSS (amber)"
                    android:textColor="#E6EDF3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/ellipse_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Dashed ellipse: the filter's own 1σ position covariance at the scrubbed epoch. It grows through the outage because nothing is correcting it, and collapses at the first accepted fix after it."
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Readout Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="At this epoch"
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/r_t"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="#E6EDF3"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/r_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="#E6EDF3"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Drift-% and yaw error are read from the artefact, not computed here."
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Scrubber Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scrubber"
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/scrubber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <org.idr26168.logger.replay.SeriesView
                    android:id="@+id/series_view"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Drift-% (blue) and |yaw error| in degrees (amber) per 1 s epoch."
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sensor Traces Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sensor traces"
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <org.idr26168.logger.replay.SensorTraceView
                    android:id="@+id/sensor_view"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/sensor_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
